{
  "name": "discord-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "bun ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "build:apk": "tsc -b && vite build && bun ./node_modules/@capacitor/cli/bin/capacitor sync android && cd android && ./gradlew assembleDebug && cd .. && cp android/app/build/outputs/apk/debug/app-debug.apk Discash.apk && cp android/app/build/outputs/apk/debug/app-debug.apk ../Discash.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "html-to-image": "^1.11.13",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "7",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
